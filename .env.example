# Pennywise — Environment Configuration

# Supabase Public Configuration (Browser + Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Secret Key (NEVER expose to browser / client bundles)
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-Only Development User Profile UUID (Default: 00000000-0000-4000-8000-000000000001)
PENNYWISE_DEV_USER_ID=00000000-0000-4000-8000-000000000001

# Server-Only AI Receipt Scanning Key (Optional Gemini Vision API)
GEMINI_API_KEY=your-gemini-api-key
